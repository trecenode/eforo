<script type="text/javascript">
function borrar(que) {
	if(que == 1) {
		que = 'el tema completo?' ;
	}
	else {
		que = 'el mensaje?' ;
	}
	if(confirm('¿Deseas borrar '+que)) {
		return true ;
	}
	else {
		return false ;
	}
}
</script>

<div class="forum-container">
	<!-- Messages List -->
	<div class="forum-card">
		<div class="forum-header">Mensajes</div>
		<div class="pagination">
			{paginas}
		</div>
		
		[blq mensaje]
		<div class="message-card">
			<div class="message-header">
				<div class="message-author">
					<a name="{mensaje.id}"></a>
					<div class="author-info">
						<h3 class="author-name">{mensaje.autor_nick}</h3>
						[blq usuario]
						<div class="author-details">
							<span class="author-rank">{mensaje.usuario.autor_rango}</span>
							<div class="author-stats">
								<span class="stat-item"><i class="fas fa-comment"></i> {mensaje.usuario.autor_mensajes}</span>
								<span class="stat-item"><i class="fas fa-circle"></i> {mensaje.usuario.autor_estado}</span>
							</div>
						</div>
						[blq avatar]
						<div class="author-avatar">
							<img src="eforo_imagenes/avatares/{mensaje.usuario.avatar.autor_id}.{mensaje.usuario.avatar.ext}" 
								 alt="{mensaje.usuario.avatar.alt}" 
								 class="avatar-image" />
						</div>
						[/blq avatar]
						[/blq usuario]
					</div>
				</div>
				<div class="message-meta">
					<span class="message-date"><i class="far fa-clock"></i> {mensaje.fecha}</span>
				</div>
			</div>
			
			<div class="message-content">
				<div class="message-topic">
					<h2>{mensaje.tema}</h2>
					<div class="message-actions">
						<button onclick="location = '{mensaje.url_citar}'" class="action-button">
							<i class="fas fa-quote-right"></i> Citar
						</button>
						<button onclick="location = '{mensaje.url_editar}'" class="action-button">
							<i class="fas fa-edit"></i> Editar
						</button>
						<button onclick="if(borrar('{mensaje.que}')) location = '{mensaje.url_borrar}'" class="action-button danger">
							<i class="fas fa-trash"></i> Borrar
						</button>
					</div>
				</div>
				<div class="message-body">
					{mensaje.contenido}
				</div>
				
				[blq firma]
				<div class="message-signature">
					{mensaje.firma.contenido}
				</div>
				[/blq firma]
				
				[blq editado]
				<div class="message-edited">
					<i class="fas fa-edit"></i> Editado por última vez: {mensaje.editado.fecha}
				</div>
				[/blq editado]
				
				[blq adjunto]
				<div class="message-attachment">
					<i class="fas fa-paperclip"></i>
					<a href="{mensaje.adjunto.url}" class="attachment-link">{mensaje.adjunto.archivo}</a>
				</div>
				[/blq adjunto]
			</div>
			
		</div>
		[/blq mensaje]
		
		<div class="pagination">
			{paginas}
		</div>
	</div>

	<!-- Quick Reply -->
	[blq respuesta_r]
	<script>
	enviado = 0 ;
	function comprobar(a) {
		a.m_mensaje.value = a.m_mensaje.value.replace(/^\s*|\s*$/g,'') ;
		if(a.m_mensaje.value.length < 3) {
			alert('Debes escribir un mensaje.') ;
			return false ;
		}
		if(enviado == 0) {
			enviado++ ;
		}
		else {
			alert('El mensaje se está enviando por favor espera.') ;
			return false ;
		}
	}
	</script>
	
	<div class="forum-card">
		<div class="forum-header">Respuesta rápida</div>
		<form method="post" action="{url_escribir}" onsubmit="return comprobar(this)" class="quick-reply-form">
			<input type="hidden" name="m_caretos" value="1" />
			<input type="hidden" name="m_codigo" value="1" />
			<input type="hidden" name="m_firma" value="1" />
			
			<div class="form-group">
				<textarea name="m_mensaje" class="form-control" placeholder="Escribe tu respuesta aquí..."></textarea>
			</div>
			
			<div class="form-actions">
				<button type="submit" name="enviar" class="submit-button">
					<i class="fas fa-paper-plane"></i> Enviar Mensaje
				</button>
			</div>
		</form>
	</div>
	[/blq respuesta_r]
</div>