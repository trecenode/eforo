<div class="forum-container">
    <!-- Moderators Section -->
    <div class="forum-card">
        <div class="forum-header">Moderadores</div>
        <div class="forum-card-content">
            <p>Total de moderadores: <b>{moderadores_total}</b></p>
            {moderadores_lista}
        </div>
    </div>

    [blq moderadores_panel]
    <script type="text/javascript">
    function sel_temas(a) {
        total = document.forms[0].elements.length;
        for(i = 0; i < total; i++) {
            casilla = document.forms[0].elements[i];
            if(casilla.type == 'checkbox') casilla.checked = a.checked;
        }
    }
    function mover() {
        if(document.m_formulario.id_foro.value == '') {
            alert('Selecciona el subforo a donde deseas mover los temas.');
            return false;
        }
        document.m_formulario.action = '{moderadores_panel.url_mover}';
        document.m_formulario.submit();
    }
    </script>

    <div class="forum-card">
        <div class="forum-header">Panel de moderación</div>
        <div class="forum-card-content">
            <form name="m_formulario" method="post" action="{moderadores_panel.url_borrar}" class="moderation-form">
                <div class="form-group">
                    <select name="id_foro" class="eforo_formulario">
                        <option value="">Mover temas al subforo...</option>
                        [blq categoria]
                        <option value="">---{moderadores_panel.categoria.titulo}---</option>
                        [blq subforo]
                        <option value="{moderadores_panel.categoria.subforo.id}">{moderadores_panel.categoria.subforo.titulo}</option>
                        [/blq subforo]
                        [/blq categoria]
                    </select>
                </div>
                <div class="form-actions">
                    <button type="button" onclick="mover()" class="btn btn-primary">
                        <i class="fas fa-arrows-alt"></i> Mover
                    </button>
                    <button type="submit" name="temas_borrar" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Borrar
                    </button>
                    <div class="checkbox-group">
                        <input id="sel_temas_c" type="checkbox" onclick="sel_temas(this)" />
                        <label for="sel_temas_c">Seleccionar todos los temas</label>
                    </div>
                </div>
            </form>
        </div>
    </div>
    [/blq moderadores_panel]

    <!-- Topics List -->
    <div class="forum-card">
        <div class="forum-header">Temas</div>
        <div class="forum-list">
            <div class="forum-item header">
                <div class="forum-icon"></div>
                <div class="forum-info">Tema</div>
                <div class="forum-stats">Autor</div>
                <div class="forum-stats">Último</div>
                <div class="forum-stats">Vis</div>
                <div class="forum-stats">Res</div>
            </div>

            <div class="pagination">
                {paginas}
            </div>

            [blq tema]
            <div class="forum-item">
                <div class="forum-icon">
                    <img src="{tema.ind_imagen}" alt="{tema.ind_mensaje}" width="24" height="24" />
                </div>
                <div class="forum-info">
                    {tema.moderar}
                    <a href="{tema.url}" class="forum-title">
                        {tema.importante}{tema.titulo}
                    </a>
                </div>
                <div class="forum-stats">{tema.tema_autor}</div>
                <div class="forum-stats">{tema.ult_men_autor}</div>
                <div class="forum-stats">{tema.num_visitas}</div>
                <div class="forum-stats">{tema.num_respuestas}</div>
            </div>
            [/blq tema]

            [blq no_hay_mensajes]
            <div class="forum-item empty">
                <div class="forum-info">
                    <p>No hay mensajes</p>
                </div>
            </div>
            [/blq no_hay_mensajes]

            <div class="pagination">
                {paginas}
            </div>
        </div>
    </div>
</div>
