<div class="forum-container">
    <main class="forum-main">
        <div class="forum-card">
            <div class="forum-card-content">
                <div class="breadcrumb">
                    <a href="{subforo_indice_url}" class="breadcrumb-link">Indice de subforos</a>
                    [blq menu_subforo]
                    <i class="fas fa-chevron-right"></i>
                    <a href="{menu_subforo.url}" class="breadcrumb-link">{menu_subforo.titulo}</a>
                    [blq menu_tema]
                    <i class="fas fa-chevron-right"></i>
                    <a href="{menu_subforo.menu_tema.url}" class="breadcrumb-link">{menu_subforo.menu_tema.titulo}</a>
                    [/blq menu_tema]
                    [/blq menu_subforo]
                </div>

                [blq nuevo_tema]
                <div class="forum-actions">
                    <a href="{nuevo_tema.nuevo_tema_url}" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Nuevo tema
                    </a>
                    [blq responder]
                    <a href="{nuevo_tema.responder.responder_url}" class="btn btn-primary">
                        <i class="fas fa-reply"></i> Responder
                    </a>
                    [/blq responder]
                </div>
                [/blq nuevo_tema]

                [blq anonimo]
                <div class="login-section">
                    <script type="text/javascript">
                    function comprobar(a) {
                        a.u_nick.value = a.u_nick.value.replace(/^\s*|\s*$/g,'');
                        a.u_contrasena.value = a.u_contrasena.value.replace(/^\s*|\s*$/g,'');
                        if(a.u_nick.value.length == 0) {
                            alert('Debes escribir un nick.');
                            return false;
                        }
                        if(a.u_contrasena.value.length == 0) {
                            alert('Debes escribir una contraseña.');
                            return false;
                        }
                    }
                    </script>
                    <div class="login-form">
                        <form name="u_formulario" method="post" action="forousuariopro.php?que=entrar" onsubmit="return comprobar(this)" class="form-inline">
                            <div class="form-group">
                                <label for="u_nick"><b>Nick:</b></label>
                                <input type="text" name="u_nick" size="10" maxlength="20" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label for="u_contrasena"><b>Contraseña:</b></label>
                                <input type="password" name="u_contrasena" size="10" maxlength="10" class="form-control" />
                            </div>
                            <button type="submit" name="enviar" class="btn btn-primary">
                                <i class="fas fa-sign-in-alt"></i> Entrar
                            </button>
                        </form>
                    </div>
                    <div class="login-links">
                        <a href="{anonimo.nuevo_usuario_e}" class="link">Nuevo usuario</a>
                        <span class="separator">|</span>
                        <a href="{anonimo.recuperar_contrasena_e}" class="link">Perdí mi contraseña</a>
                    </div>
                </div>
                [/blq anonimo]

                [blq usuario]
                <div class="user-section">
                    <div class="user-info">
                        <span class="welcome">Bienvenid@ <b>{usuario.usuario_nick}</b></span>
                        [blq nuevos_mensajes]
                        <span class="new-messages">
                            <a href="{usuario.nuevos_mensajes.url_privados}" class="admin-link">
                                <i class="fas fa-envelope"></i> Tienes {usuario.nuevos_mensajes.total} mensaje(s) nuevo(s)
                            </a>
                        </span>
                        [/blq nuevos_mensajes]
                    </div>
                    <div class="user-actions">
                        <a href="{usuario.url_privados}" class="action-link" title="Mensajes Privados">
                            <i class="fas fa-envelope"></i>
                        </a>
                        <a href="{usuario.url_perfil}" class="action-link" title="Perfil">
                            <i class="fas fa-user-circle"></i>
                        </a>
                        <a href="{usuario.url_leidos}" class="action-link" title="Marcar subforos como leídos">
                            <i class="fas fa-book-open"></i>
                        </a>
                        {usuario.url_panel}
                        <a href="forousuariopro.php?que=salir" class="action-link logout" title="Salir del Foro">
                            <i class="fas fa-sign-out-alt"></i>
                        </a>
                    </div>
                </div>
                [/blq usuario]
            </div>
        </div>
    </main>
</div>