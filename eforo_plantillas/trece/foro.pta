<div class="forum-container">
    <!-- Forums List -->
    <div class="forum-card">
        <div class="forum-header">Foros</div>
        <div class="forum-list">
            [blq categoria]
            <div class="forum-subheader">
                <div class="eforo_titulo_2">{categoria.titulo}</div>
            </div>
            [blq subforo]
            <div class="forum-item">
                <div class="forum-icon">
                    <img src="{categoria.subforo.ind_imagen}" alt="{categoria.subforo.ind_mensaje}" width="24" height="24" />
                </div>
                <div class="forum-info">
                    <a href="{categoria.subforo.titulo_url}" class="forum-title">{categoria.subforo.titulo}</a>
                    <div class="forum-description">{categoria.subforo.descripcion}</div>
                </div>
                <div class="forum-stats">
                    <span>{categoria.subforo.ult_mensaje}</span>
                </div>
                <div class="forum-stats">
                    <span>{categoria.subforo.num_temas}</span>
                </div>
                <div class="forum-stats">
                    <span>{categoria.subforo.num_mensajes}</span>
                </div>
            </div>
            [/blq subforo]
            [/blq categoria]
        </div>
    </div>

    <!-- Statistics -->
    <div class="forum-card">
        <div class="forum-header">Estadísticas</div>
        <div class="stats-grid">
            <div class="stats-card">
                <p>Nos visitan <b>{usuarios_total}</b> usuarios: <b>{usuarios_registrados}</b> registrados y <b>{usuarios_anonimos}</b> anónimos</p>
                <p>{usuarios_reg_en_linea}</p>
            </div>
            <div class="stats-card">
                <p>Total de usuarios: <b>{usuarios_reg_total}</b></p>
                <p>Último registrado: <b>{usuarios_reg_ultimo}</b></p>
                <a href="{usuarios_lista}" class="eforo_enlace">→ Lista de usuarios</a>
            </div>
        </div>
    </div>
</div>
